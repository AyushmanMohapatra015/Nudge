{
  "name": "nudge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "start:render": "node scripts/start-render.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "paypal:check": "node --env-file=.env.local scripts/check-paypal.mjs",
    "elastic:check": "node --env-file=.env.local scripts/check-elastic-config.mjs",
    "db:backup": "node scripts/database-maintenance.mjs backup",
    "db:verify": "node scripts/database-maintenance.mjs verify",
    "db:restore": "node scripts/database-maintenance.mjs restore",
    "db:render": "node scripts/render-database-maintenance.mjs",
    "postman:check": "node --env-file=.env.local scripts/check-postman.mjs",
    "postman:workflow": "node scripts/check-postman-workflow.mjs",
    "typecheck": "tsc --noEmit",
    "privacy:check": "node scripts/check-public-source.mjs",
    "privacy:history": "node scripts/check-public-history.mjs",
    "privacy:browser": "node scripts/check-postman-workflow.mjs --review-browser-artifacts",
    "verify:clean": "node scripts/verify-clean-source.mjs",
    "a11y:manual": "node scripts/start-accessibility-review.mjs",
    "evaluation:summary": "tsx scripts/summarize-scope.ts",
    "evaluation:baseline": "tsx scripts/run-scope-baseline.ts"
  },
  "dependencies": {
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@7.3.7",
    "@bryntum/gantt-react": "7.3.8",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
