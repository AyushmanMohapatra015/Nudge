# No credentials are required for the clearly labeled local simulation.
NUDGE_MODE=demo
# Set NUDGE_MODE=sandbox for PayPal sandbox; real AI also requires the enable flag.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_EMAIL=
PAYPAL_WEBHOOK_ID=
# Optional read-only Postman lookup. Keep the actual sandbox invoice ID local.
POSTMAN_INVOICE_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
NUDGE_AI_PROVIDER=anthropic
# Leave false until provider allowance and first-test scope are confirmed.
# This is an enable switch, not a dollar/token spending cap.
NUDGE_AI_ENABLED=false
# Optional sponsor gateway. Keep credentials local; use the provider-supplied HTTPS host.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
ASTRO_MODEL=bedrock/claude-haiku-4-5
# Optional Elastic Cloud Agent Builder (Kibana origin, not Elasticsearch endpoint).
# Keep AI disabled until trial allowance and first-test scope are confirmed.
ELASTIC_KIBANA_URL=
ELASTIC_API_KEY=
ELASTIC_AGENT_ID=
ELASTIC_SPACE_ID=
# Optional actual inference endpoint ID; not a model display name or API key.
ELASTIC_INFERENCE_ID=
# Required in sandbox mode. Never use a public or guessable value.
NUDGE_ADMIN_TOKEN=
NUDGE_DB_PATH=./data/nudge.sqlite
