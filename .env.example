NUDGE_MODE=demo
# Set NUDGE_MODE=sandbox to use actual PayPal sandbox and Claude requests.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_EMAIL=
PAYPAL_WEBHOOK_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
