{
  "info": {
    "name": "Nudge — isolated simulation workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run using scripts/check-postman-workflow.mjs only. Creates a disposable local server/database, never uses your ordinary workspace or integration credentials. AI and payments are simulated. No reset action, account signup, external API call or cloud monitor."
  },
  "variable": [
    {
      "key": "base_url",
      "value": ""
    },
    {
      "key": "client_token",
      "value": ""
    },
    {
      "key": "proposal_id",
      "value": ""
    },
    {
      "key": "review_id",
      "value": ""
    },
    {
      "key": "invoice_id",
      "value": ""
    },
    {
      "key": "original_analysis",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Fresh isolated simulation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{base_url}}"
          }
        ],
        "url": "{{base_url}}/api/workspace"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json(); pm.test('Fresh demo with all real integrations disabled', () => { pm.expect(d.mode).to.eql('demo'); pm.expect(d.aiEnabled).to.eql(false); pm.expect(d.connections).to.deep.eql({paypal:false,ai:false,webhook:false}); pm.expect(d.version).to.eql(1); pm.expect(d.agreementStatus).to.eql('draft'); pm.expect(d.proposals).to.have.lengthOf(0); pm.expect(d.invoices).to.have.lengthOf(0); });",
              "pm.collectionVariables.set('client_token', d.clientToken); pm.collectionVariables.set('review_id', '');"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Invoice blocked before scope acceptance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{base_url}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/workspace",
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"createInvoice\",\"id\":\"base\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Owner approves agreement",
