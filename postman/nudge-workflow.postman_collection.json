          "raw": "{\"type\":\"approveAgreement\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Approval is not acceptance', () => pm.expect(pm.response.json().agreementStatus).to.eql('approved'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Client view hides owner records",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{base_url}}"
          }
        ],
        "url": "{{base_url}}/api/client/{{client_token}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "function privateView(d) { ['audit','policies','clientToken','processing','connections','aiEnabled','reminderDraft'].forEach(k => pm.expect(d).not.to.have.property(k)); }",
              "const d = pm.response.json(); pm.test('Public decision view excludes owner records', () => { privateView(d); pm.expect(d.agreementStatus).to.eql('approved'); });"
            ]
          }
        }
      ]
    },
